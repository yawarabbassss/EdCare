# ==========================================================
# LEO Elderly Care Assistant - Environment Configuration
# ==========================================================

# Core Application Settings
PROJECT_NAME="LEO Elderly Care Assistant"
VERSION=1.0.0
DEBUG=True

# Security & Authentication
SECRET_KEY=change_this_to_a_secure_random_production_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Connection (SQLite default for instant local setup; PostgreSQL for production)
DATABASE_URL=sqlite:///./leo_care.db
# DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/leo_care

# Optional Redis / PubSub Broker
# REDIS_URL=redis://localhost:6379/0

# AI Provider Configuration ("local", "openai", "grok", "gemini")
AI_PROVIDER=local
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Speech Services (Whisper STT & TTS)
STT_PROVIDER=local
STT_API_KEY=
TTS_PROVIDER=local
TTS_API_KEY=

# Fall Detection Engine Configuration
FALL_CONFIDENCE_THRESHOLD=0.85
FALL_CONFIRMATION_SECONDS=2.5
MIN_FALL_DURATION_FRAMES=8
PERSON_DETECTION_CONFIDENCE=0.60

# Frontend URLs
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/ws
